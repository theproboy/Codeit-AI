# Get a free key at https://console.groq.com/keys and copy it here.
# The /explain and /debug endpoints need it; /run works without it.
GROQ_API_KEY=

# Optional: comma-separated origins allowed to call the API (CORS).
# Defaults to localhost/127.0.0.1 on any port. Set this if you serve the frontend elsewhere,
# e.g. ALLOWED_ORIGINS=null to allow opening frontend/index.html directly as a file:// page.
ALLOWED_ORIGINS=
